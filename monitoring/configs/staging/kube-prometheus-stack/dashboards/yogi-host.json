          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "node_hwmon_temp_celsius{job=\"node-exporter\",instance=\"$instance\"} * on (chip) group_left(chip_name) node_hwmon_chip_names{job=\"node-exporter\",instance=\"$instance\"}",
          "legendFormat": "{{chip_name}} {{sensor}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
