          "expr": "node_power_supply_online{job=\"node-exporter\",instance=\"$instance\",power_supply=\"ACAD\"} * 100",
          "legendFormat": "on AC (100 = yes)",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ]
